#!/usr/bin/env python3
"""Search the indexed Curam product manuals.

Thin wrapper over the agency's manuals search API so agents have one stable
command regardless of how the index is hosted. Configure in kit.config.yaml:

  manuals_endpoint: https://host/search   # your search service
  manuals_api_key_env: MANUALS_API_KEY    # env var holding the key (optional)

Usage: manuals-search "query text" [--top N]

Fill in `search()` below to match your service's request/response shape —
it should return a list of {title, snippet, source} dicts.
"""
import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "xref"))
from common import find_repo_root, load_config  # noqa: E402


def search(endpoint: str, api_key: str | None, query: str, top: int):
    """ADAPT ME: default implementation assumes a JSON POST API of shape
    {query, top_k} -> {results: [{title, snippet|text, source|url}]}."""
    req = urllib.request.Request(
        endpoint,
        data=json.dumps({"query": query, "top_k": top}).encode(),
        headers={"Content-Type": "application/json",
                 **({"Authorization": f"Bearer {api_key}"} if api_key else {})})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.load(r)
    out = []
    for hit in data.get("results", [])[:top]:
        out.append({"title": hit.get("title", "?"),
                    "snippet": hit.get("snippet") or hit.get("text", ""),
                    "source": hit.get("source") or hit.get("url", "")})
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("query")
    ap.add_argument("--top", type=int, default=5)
    args = ap.parse_args()

    cfg = load_config(find_repo_root())
    endpoint = cfg.get("manuals_endpoint")
    if not endpoint:
        raise SystemExit("manuals_endpoint not set in kit.config.yaml")
    key_env = cfg.get("manuals_api_key_env")
    api_key = os.environ.get(key_env) if key_env else None

    for i, hit in enumerate(search(endpoint, api_key, args.query, args.top), 1):
        print(f"--- {i}. {hit['title']}  [{hit['source']}]")
        print(hit["snippet"].strip()[:1500])
        print()


if __name__ == "__main__":
    main()
