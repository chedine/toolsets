{
  "url": "http://localhost:18081/Curam/AppController.do",
  "dataDir": "./data",
  "cleanTabsOnStart": true,
  "maximized": true,
  "extraHTTPHeaders": {
    "ngrok-skip-browser-warning": "1"
  },
  "viewport": {
    "width": 1800,
    "height": 1000
  },
  "until": {
    "timeout": 600,
    "interval": 15
  },
  "generate": {
    "^First Name$": {
      "type": "firstName"
    },
    "^Last Name$": {
      "type": "lastName",
      "unique": true
    },
    "^Social Security Number$": {
      "type": "ssn",
      "area": "091"
    }
  }
}